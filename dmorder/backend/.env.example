# Copy to .env and fill in. NEVER commit a real .env with secrets.
PORT=5000
JWT_SECRET=
MONGO_URI=
# Instagram API with Instagram Login (Official Meta Platform)
# App type: "Instagram API with Instagram Login" (no Facebook Page required)
IG_APP_ID=
IG_APP_SECRET=
# Optional: explicitly set redirect URI; defaults to ${BACKEND_URL}/api/v2/instagram/callback
IG_REDIRECT_URI=
IG_GRAPH_VERSION=v21.0

# Legacy Meta App credentials (fallback if IG_APP_ID / IG_APP_SECRET are not set)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_CONFIG_ID=
META_ACCESS_TOKEN=
# META_API_MOCK=true (set only during tests to mock Meta Graph API endpoints)
META_API_MOCK=
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# PRODUCTION RULES (added 27 Oct 2026 security hardening):
# - JWT_SECRET is REQUIRED in production (server refuses to start without it).
# - META_APP_SECRET is REQUIRED for webhook POSTs in production (unsigned webhooks are rejected).
# - MONGO_URI is REQUIRED in production (server refuses to run on the in-memory store).
# - CORS_ORIGIN must list only the real dashboard origin(s) in production.
ENCRYPTION_KEY=
# Required before any Instagram token can be stored. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# WhatsApp route is an owner decision (Cloud API direct vs BSP). Leave empty until decided.
AI_API_KEY=
# LLM provider is an owner decision. Leave empty until decided; the rule-based catalog engine runs without it.
PAYMENT_PROVIDER=
# Payment provider is an owner decision (Razorpay was only a candidate). Leave empty until decided.
ADMIN_EMAIL=
# First admin: the seller who registers with this email becomes isAdmin. Set before registering the admin account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Email provider (any SMTP provider) — leave empty until decided; forgot-password/verify emails are then stored but not sent.

# Firebase Auth (Email OTP verification during seller account creation)
FIREBASE_PROJECT_ID=
REQUIRE_PHONE_OTP=false
# REQUIRE_PHONE_OTP=true means email OTP/Google verification is mandatory for registration
